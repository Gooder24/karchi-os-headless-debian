#!/bin/sh
# Makes the first line of a user's ~/.bashrc read /usr/lib/karchi/agent-path; run again it changes nothing.
#   agent-path-into-bashrc <user>                 the installer (post-install) and the upgrade (postinst) run it
#   agent-path-into-bashrc --self-test            check the logic on a temporary file and exit
set -eu
line='. /usr/lib/karchi/agent-path  # karchi-headless: agent tools for SSH commands too'

into() {  # into <file>: our line first, the rest as it was, owner and mode kept; a symlink is followed
  [ ! -L "$1" ] || set -- "$(readlink -f "$1")"
  if [ -e "$1" ] && head -1 "$1" | grep -qF '/usr/lib/karchi/agent-path'; then return 0; fi
  tmp=$(mktemp "$1.XXXXXX")
  { echo "$line"; [ ! -e "$1" ] || cat "$1"; } > "$tmp"
  if [ -e "$1" ]; then chown --reference="$1" "$tmp"; chmod --reference="$1" "$tmp"; else chmod 644 "$tmp"; fi
  mv "$tmp" "$1"
}

if [ "${1:-}" = --self-test ]; then
  dir=$(mktemp -d)
  trap 'rm -rf "$dir"' EXIT
  printf 'case $- in *i*) ;; *) return;; esac\nalias ll=ls\n' > "$dir/bashrc"
  chmod 640 "$dir/bashrc"
  into "$dir/bashrc"
  into "$dir/bashrc"
  [ "$(head -1 "$dir/bashrc")" = "$line" ]
  [ "$(grep -c agent-path "$dir/bashrc")" = 1 ]
  [ "$(sed -n 3p "$dir/bashrc")" = 'alias ll=ls' ]
  [ "$(stat -c %a "$dir/bashrc")" = 640 ]
  into "$dir/new"
  [ "$(cat "$dir/new")" = "$line" ] && [ "$(stat -c %a "$dir/new")" = 644 ]
  # A dotfiles symlink stays a symlink, its target gets the line.
  printf 'alias ll=ls\n' > "$dir/dotfiles-bashrc"
  ln -s dotfiles-bashrc "$dir/link"
  into "$dir/link"
  [ -L "$dir/link" ] && [ "$(head -1 "$dir/dotfiles-bashrc")" = "$line" ]
  # What the line does: a non-interactive SSH command finds ~/.local/bin and an existing ~/.bun/bin, once.
  mkdir -p "$dir/.bun/bin"
  path=$(HOME=$dir PATH=/usr/bin:/bin sh -c '. "$1"; . "$1"; echo "$PATH"' - "$(dirname "$0")/agent-path")
  [ "$path" = "$dir/.local/bin:$dir/.bun/bin:/usr/bin:/bin" ] || { echo "PATH=$path"; exit 1; }
  echo 'agent-path-into-bashrc: self-test ok'
  exit
fi

user=${1:?usage: agent-path-into-bashrc <user>}
home=$(getent passwd "$user" | cut -d: -f6)
[ -d "$home" ] || exit 0
if [ -L "$home/.bashrc" ] && [ "$(stat -L -c %U "$home/.bashrc" 2> /dev/null)" != "$user" ]; then
  echo "agent-path-into-bashrc: $home/.bashrc links to a file $user does not own, left as it was" >&2
  exit 0
fi
into "$home/.bashrc"
chown "$user:" "$home/.bashrc"
