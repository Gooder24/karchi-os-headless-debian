#!/bin/bash
# Is this KarchiOS Headless server healthy? Run it on the console or over SSH, as yourself.
#   ok    works
#   WARN  works, but something is still to be done by hand (the line says what)
#   FAIL  broken; the exit code is then 1
# It changes nothing. Its parts check themselves too: laptop-server check, reboot-when-idle status.
set -u
failed=0

check() {  # check "<description>" <command...>
  local name=$1 output
  shift
  if output=$("$@" 2>&1); then
    printf 'ok    %s\n' "$name"
  else
    printf 'FAIL  %s\n' "$name"
    [[ -n $output ]] && sed 's/^/        /' <<< "$output"
    failed=1
  fi
}

warn() { printf 'WARN  %s\n' "$1"; }

no_failed_units() {
  local units
  units=$(systemctl --failed --no-legend --plain)
  [[ -z $units ]] || { echo "$units"; return 1; }
}

all_units() {  # all_units is-active|is-enabled <unit...>: systemctl alone is content when one of them is
  local state=$1 unit
  shift
  for unit; do
    systemctl "$state" --quiet "$unit" || { echo "$unit: $(systemctl "$state" "$unit")"; return 1; }
  done
}

automatic_updates() {  # unattended-upgrades runs every day and leaves the reboot to reboot-when-idle
  local lists upgrade reboot
  eval "$(apt-config shell lists APT::Periodic::Update-Package-Lists upgrade APT::Periodic::Unattended-Upgrade \
    reboot Unattended-Upgrade::Automatic-Reboot)"
  [[ ${lists:-0} != 0 && ${upgrade:-0} != 0 ]] || { echo 'APT::Periodic is off'; return 1; }
  [[ ${reboot:-false} == false ]] || { echo 'unattended-upgrades reboots by itself (Automatic-Reboot)'; return 1; }
  all_units is-enabled apt-daily.timer apt-daily-upgrade.timer
}

echo 'the system'
check 'no failed service' no_failed_units
check 'services run: network, Wi-Fi, Tailscale' all_units is-active systemd-networkd systemd-resolved iwd tailscaled

if ip route get 1.1.1.1 > /dev/null 2>&1; then
  printf 'ok    %s\n' "network: $(ip -4 -o route get 1.1.1.1 | sed 's/.* dev \([^ ]*\).* src \([^ ]*\).*/\2 on \1/')"
else
  warn 'no network: Wi-Fi with "iwctl station wlan0 connect <network>", or plug in a cable'
fi

case $(tailscale status --json 2> /dev/null | sed -n 's/.*"BackendState": *"\([^"]*\)".*/\1/p') in
  Running) printf 'ok    %s\n' "Tailscale: $(tailscale ip -4 2> /dev/null | head -1)" ;;
  NeedsLogin | NoState | Stopped) warn 'Tailscale is not logged in: sudo tailscale up --ssh' ;;
  *) printf 'FAIL  %s\n' 'Tailscale does not answer'; failed=1 ;;
esac

echo 'the laptop (laptop-server check)'
laptop-server check || failed=1

echo 'updates and reboots (reboot-when-idle status)'
check 'security updates install themselves, every day' automatic_updates
check 'the nightly reboot waits for agents' all_units is-active reboot-when-idle.timer
while read -r line; do
  warn "$line"
done < <(reboot-when-idle status 2> /dev/null | awk '/^needs a look:/ { look = 1; next } /^[^ ]/ { look = 0 } look { sub(/^ +/, ""); print }')
if [[ -d ~/.claude ]] && ! grep -qs 'reboot-when-idle hook' ~/.claude/settings.json; then
  warn 'Claude Code does not tell reboot-when-idle when it works: merge /usr/share/reboot-when-idle/claude-code-hooks.json into ~/.claude/settings.json'
fi
exit $failed
