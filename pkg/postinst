#!/bin/sh
# Settings that moved to laptop-server (2026-10-15) go; so does the start link of the old display service,
# whose file went with the upgrade. Installing from the ISO does the rest (/usr/lib/karchi/post-install).
set -e
dpkg-maintscript-helper rm_conffile /etc/keyd/karchi.conf 2026.10.15~ karchi-headless -- "$@"
dpkg-maintscript-helper rm_conffile /etc/default/grub.d/karchi.cfg 2026.10.15~ karchi-headless -- "$@"
[ "$1" = configure ] || exit 0
rm -f /etc/systemd/system/multi-user.target.wants/karchi-display-off.service
# A machine installed before 2026-11-09: its people get the agent tools in SSH commands too (post-install does
# this at installation). Run again it changes nothing.
getent group sudo | cut -d: -f4 | tr ',' '\n' | while read -r user; do
  if [ -n "$user" ]; then /usr/lib/karchi/agent-path-into-bashrc "$user"; fi
done
# /tmp goes back to the disk (Debian 13 made it a tmpfs of half the memory). Agents leave browser profiles, builds and
# test files there; in a tmpfs they take memory until the next reboot: 4.4 GB of 15.6 on asus, 0.8 of 3.8 on dell
# (2026-11-09). On the disk they take disk, and systemd-tmpfiles still clears what is 10 days old. Once, at the
# installation or the upgrade that brings it, so that an "unmask" by hand stays. Takes effect at the next start.
if [ -z "${2:-}" ] || dpkg --compare-versions "$2" lt 2026.11.09; then
  systemctl mask tmp.mount > /dev/null 2>&1 || true
fi
# earlyoom now starts with the rules of its drop-in (10-karchi.conf).
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
  systemctl enable earlyoom > /dev/null 2>&1 || true
  systemctl restart earlyoom || true
fi
